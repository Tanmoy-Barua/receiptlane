# USCIS Torch API credentials (optional)
# Get these from https://developer.uscis.gov/
# Without them, ReceiptLane runs in demo mode.

USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=

# Sandbox defaults (official Case Status API)
USCIS_TOKEN_URL=https://api-int.uscis.gov/oauth/accesstoken
USCIS_CASE_STATUS_URL=https://api-int.uscis.gov/case-status

# Force demo responses even if credentials are present
# USCIS_FORCE_DEMO=1
